# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://refound:refound@localhost:5432/refound
PORT=3000
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=10

# Used only by `npm run seed:staff`. Staff accounts are never created through the API.
STAFF_NAME=Help Desk
STAFF_EMAIL=staff@campus.edu
STAFF_PASSWORD=change-this-before-running
