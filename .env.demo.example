# Demo-host config (the faculty free host). Placeholders only. Never commit real values.
# The SAME image as local runs with this file. Nothing is rebuilt to switch environment:
#   docker run --rm --env-file .env.demo -p 127.0.0.1:10000:10000 refound-api:local
# On Render these are set in the dashboard / render.yaml, never in the image.

PORT=10000
# The demo host's own database (internal URL from the host's dashboard).
DATABASE_URL=postgres://DEMO_USER:DEMO_PASSWORD@DEMO_DB_HOST:5432/refound
# A different secret from local, so local tokens don't work on the demo.
JWT_SECRET=replace-with-a-different-32-plus-character-secret
JWT_EXPIRES_IN=12h
